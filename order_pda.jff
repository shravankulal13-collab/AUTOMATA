<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>pda</type>
	<automaton>
		<!-- State Definitions -->
		<state id="0" name="q0">
			<x>120.0</x>
			<y>160.0</y>
			<initial/>
		</state>
		<state id="1" name="q1">
			<x>380.0</x>
			<y>160.0</y>
			<final/>
		</state>
		<!-- Transitions: read, pop ; push -->
		<transition>
			<from>0</from>
			<to>0</to>
			<read>o</read>
			<pop>Z</pop>
			<push>OZ</push>
		</transition>
		<transition>
			<from>0</from>
			<to>0</to>
			<read>o</read>
			<pop>O</pop>
			<push>OO</push>
		</transition>
		<transition>
			<from>0</from>
			<to>0</to>
			<read>p</read>
			<pop>O</pop>
			<push/>
		</transition>
		<transition>
			<from>0</from>
			<to>1</to>
			<read/>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
	</automaton>
</structure>

